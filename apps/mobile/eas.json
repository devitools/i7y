{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "I7Y_BUILD_VARIANT": "development"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "I7Y_BUILD_VARIANT": "production",
        "EXPO_PUBLIC_I7Y_PUSH_GATEWAY_URL": "https://i7y-push.disk.ninja"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "environment": "production"
    },
    "simulator": {
      "developmentClient": false,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "I7Y_BUILD_VARIANT": "simulator"
      }
    },
    "device": {
      "developmentClient": false,
      "distribution": "internal",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "I7Y_BUILD_VARIANT": "production",
        "EXPO_PUBLIC_I7Y_PUSH_GATEWAY_URL": "https://i7y-push.disk.ninja"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "apple@wilcorrea.dev",
        "appleTeamId": "6Y2CA8W7JV",
        "ascAppId": "6828724152"
      },
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    }
  }
}
